# LLM API 配置
# Get your API key from your LLM provider
API_KEY=your-api-key-here
BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
MODEL=minimax-m2.5

# MySQL 配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=traveluser
DB_PASSWORD=change-me
DB_NAME=travelbook

# Geocoding 配置
GEOCODE_PROVIDER=opencage
GEOCODE_API_KEY=your-opencage-api-key
GEOCODE_TIMEOUT=8.0
